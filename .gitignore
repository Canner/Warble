# Rust build output (single Cargo workspace at the repo root)
/target

# local run artifacts
*.log
.DS_Store

# eval trace cache (per-case results; content-addressed, regenerated by `warble eval run`)
.warble/

# TS dispatcher (Node)
node_modules/
dist/
*.tsbuildinfo

# emitted agent runtime files from a dispatch/e2e run in-tree (project config under .claude/ is kept)
.claude/agents/
# local git worktrees created during development (never part of a release snapshot)
.claude/worktrees/

# wren build output inside examples (regenerated by `wren context build`; warble reads the raw yml)
examples/*/target/

# driftwood example: the DuckDB + fault-injection artifacts are generated, not committed
# (deterministic `uv run generate.py [--inject <scenario>]`). The injection manifest schema
# is documented in the README; regenerate the pair + manifest on demand as an eval setup step.
examples/driftwood-wren/*.duckdb
examples/driftwood-wren/*.duckdb.wal
examples/driftwood-wren/*.manifest.yaml
examples/driftwood-wren/__pycache__/
