{
  "warble_ir_version": "0.8",
  "profile": "portable_analysis",
  "config": {},
  "context_binding": {"project": "not-installed/context", "binding_mode": "runtime_selected"},
  "slots": [{"name": "tone", "default": "base", "variants": {"base": "Be precise.", "terse": "Be brief."}}],
  "components": [{
    "id": "analyze",
    "entrypoint": true,
    "verb": "analyze",
    "type": "analytical",
    "realization_kind": "skill",
    "context_binding": {"project": "not-installed/context", "binding_mode": "runtime_selected"},
    "precondition_result": {"status": "pass", "checks": [{"predicate": "context_ready", "outcome": "pass"}]},
    "context_precondition": [{"predicate": "context_ready"}],
    "context_requirements": ["A host-bound semantic context"],
    "brief": "Use the bound named operations. {{ slot.tone }}",
    "prompt_fragment": "Derived display text; not the executable step plan.",
    "llm_calls": [
      {
        "name": "inspect", "tier": "cheap", "consumes": [], "produces": "intent",
        "conditional": false, "when": null, "capabilities": ["semantic_introspection"],
        "prompt": "Inspect the bound context and resolve intent."
      },
      {
        "name": "query", "tier": "strong", "consumes": ["intent"], "produces": "result",
        "produces_exclusive": true, "conditional": false, "when": null,
        "capabilities": ["sql_execution:read_only"],
        "prompt": "Execute the intent read-only; retain verified results or a non-secret failure result."
      },
      {
        "name": "repair", "tier": "strong", "consumes": ["intent", "result"], "produces": "repaired",
        "produces_exclusive": true, "conditional": true,
        "when": {"guard": "on_failure", "target": "query"},
        "capabilities": ["sql_execution:read_only"],
        "prompt": "Repair only a failed query once, otherwise do not run. Refuse if validation still fails."
      }
    ],
    "guardrails": [
      {"name": "read_only_execution", "locked": true},
      {"name": "row_limit", "locked": false, "threshold": 100},
      {"name": "statement_timeout", "locked": false, "threshold": 30},
      {"name": "deterministic_gate", "locked": true}
    ],
    "trigger": {"kind": "one_shot"},
    "required_capabilities": ["semantic_introspection", "sql_execution:read_only", "llm:cheap", "llm:strong", "llm:per_step_tier"],
    "borrowed_actions": ["introspect"],
    "eval_ref": "analyze.eval",
    "params": [],
    "effect": {"outcome": {"kind": "none"}, "render_blocks": [{"type": "table", "fields": {"columns": "string[]", "rows": "row[]"}}]}
  }]
}
