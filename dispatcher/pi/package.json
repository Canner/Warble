{
  "name": "@warble/pi",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Warble pi hybrid private runner and Cedar disclosure boundary",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:mutations": "node tests/mutation.mjs",
    "pretest:mutations": "npm run build",
    "pretest": "npm run build",
    "precheck-types": "npm run build"
  },
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.14.0",
    "@earendil-works/pi-agent-core": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  },
  "bin": {
    "warble-pi": "dist/cli.js",
    "warble-pi-service": "dist/service.js"
  }
}
